# 360_NPT
set_view (\
    -0.659279346,    0.535662174,   -0.527648985,\
    -0.680162430,   -0.125747532,    0.722187579,\
     0.320497751,    0.835012853,    0.447241813,\
     0.000544637,   -0.000450537, -325.989410400,\
    62.121635437,   54.650863647,   65.284599304,\
   256.984924316,  394.923889160,  -20.000000000 )

### cut above here and paste into script ###

# 居中并自动缩放到刚好包含主体（留 20 Å 缓冲）
center hb_bases
zoom hb_bases, buffer=20

# 标签可读性设置
set label_size, 24
set label_font_id, 7

# 高分辨率渲染并保存到指定路径
# width/height 设置图片像素，可根据需要调大
ray 4000, 3000
# png ../img/3rd_pdb.png, dpi=300
# png ../img/3rd_300_NVT.png, dpi=300
# png ../img/3rd_300_NPT.png, dpi=300
# png ../img/3rd_360_NVT.png, dpi=300
png ../img/3rd_360_NPT.png, dpi=300