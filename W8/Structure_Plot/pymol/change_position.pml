##############################################
# RNA 结构视角/位置/大小 规范化脚本（自动画布）
##############################################

# 背景和抗锯齿
bg_color white
set ray_opaque_background, on
set antialias, 2
set orthoscopic, on

# 固定视角矩阵（替换为你的 get_view 值）
# pdb
# set_view (\
#     -0.241258383,   -0.796286166,   -0.554726243,\
#     -0.963482320,    0.264918089,    0.038754717,\
#      0.116088428,    0.543819368,   -0.831128836,\
#      0.000000000,    0.000000000, -213.784255981,\
#     28.283065796,  -20.033359528,   -1.042981148,\
#    168.549133301,  259.019378662,  -20.000000000 )

