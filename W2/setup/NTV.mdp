
; VARIOUS PREPROCESSING OPTIONS
title                    = NTV simulation (constant number, temperature and volume)

; RUN CONTROL PARAMETERS
integrator               = md
dt                       = 0.002
nsteps                   = 500000

; OUTPUT CONTROL OPTIONS
; THESE ARE SMALL NUMBERS, JUST FOR TEST. MAKE THIS NUMBER 100 TIMES LARGER ON A SERIOUS COMPUTER OR YOUR OUTPUT FILES WILL BE TOO LARGE
nstxout                  = 10000                ;  (coordinates)
nstvout                  = 0                    ; No output, except for last frame (velocities)
nstfout                  = 0                    ; No output, except for last frame (forces)
nstlog                   = 10                   ; Write every step to the log 
nstenergy                = 100                    ; Write energies at every step
nstxtcout                = 0                    ; Do not write a compressed trajectory


; NEIGHBORSEARCHING PARAMETERS
nstlist		= 40		; Frequency to update the neighbor list and long range forces
ns_type		= grid		; Method to determine neighbor list (simple, grid)
rlist		= 1.0		; Cut-off for making neighbor list (short range forces)
pbc                      = xyz

; OPTIONS FOR ELECTROSTATICS AND VDW
coulombtype              = PME
rcoulomb                 = 1.1
rvdw                     = 1.1
optimize_fft		=	yes


; TEMPERATURE COUPLING  
tcoupl                   = v-rescale
tc-grps                  = RNA Water Ion
tau_t                    = 1.0    1.0    1.0
ref_t                    = 300    300    300

; CONSTRAINTS
constraints		=	hbonds
constraint_algorithm	=	LINCS

; PRESSURE COUPLING   
refcoord_scaling        =       all
pcoupl                  =	No

cutoff-scheme = Verlet


